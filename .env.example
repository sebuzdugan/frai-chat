# Copy to .env.local for local development.
# All LLM calls happen client-side with user-supplied keys — these are only used
# by the ingest script (Node) to chunk local corpus files.

# Optional: override the default embedding model for the ingest step.
# Defaults to Xenova/bge-small-en-v1.5 (384 dims, ~30MB quantized).
FRAI_CHAT_EMBED_MODEL=Xenova/bge-small-en-v1.5

# Optional: set the base path when deploying under a subpath (e.g. github.io/frai-chat).
# NEXT_PUBLIC_BASE_PATH=/frai-chat
